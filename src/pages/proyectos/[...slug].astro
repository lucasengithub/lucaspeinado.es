---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id.replace(/\.md$/, "") },
        props: { post },
    }));
}

type Props = { post: CollectionEntry<"blog"> };

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} />
<main>
    <article>
        <header>
            <div id="top">
                <a href="/"> 🡐 Volver </a>
                <hr />
            </div>
            <time>{post.data.year}</time>
            <h1>{post.data.title}</h1>
            {
                post.data.description && (
                    <p class="description">{post.data.description}</p>
                )
            }
        </header>

        {
            post.data.image && (
                <figure>
                    <img src={post.data.image.url} alt={post.data.image.alt} />
                </figure>
            )
        }

        <div class="content">
            <Content />
        </div>
    </article>
</main>

<style>
    main {
        max-width: 720px;
        margin: 0 auto;
        padding: 6rem 1.5rem 4rem;
    }

    header {
        margin-bottom: 2rem;
    }

    time {
        font-size: 0.875rem;
        color: #666;
    }

    h1 {
        font-size: 2.5rem;
        font-weight: 1000;
        margin: 0.5rem 0;
        font-family: "DM Sans", sans-serif;
        text-transform: uppercase;
        color: red;
    }

    .description {
        font-size: 1.125rem;
        color: #444;
    }

    figure {
        margin: 2rem 0;
    }

    figure img {
        width: 100%;
        height: auto;
    }

    .content {
        font-size: 1rem;
        line-height: 1.8;
    }

    .content :global(h2) {
        font-size: 1.5rem;
        margin: 2rem 0 0.75rem;
    }

    .content :global(h3) {
        font-size: 1.25rem;
        margin: 1.5rem 0 0.5rem;
    }

    .content :global(p) {
        margin-bottom: 1rem;
    }

    .content :global(a) {
        color: rgb(255, 0, 0);
        text-decoration: underline;
    }

    .content :global(ul),
    .content :global(ol) {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }

    .content :global(li) {
        margin-bottom: 0.25rem;
    }

    .content :global(code) {
        background: #f4f4f4;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
    }

    .content :global(pre) {
        background: #1a1a1a;
        color: #eee;
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 1rem;
    }

    .content :global(pre code) {
        background: none;
        padding: 0;
        color: inherit;
    }

    .content :global(blockquote) {
        border-left: 3px solid rgb(255, 0, 0);
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: #555;
    }
</style>
