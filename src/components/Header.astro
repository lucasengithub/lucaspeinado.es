<header>
    <h1>Lucas Peinado</h1>

    <div class="links">
        <a href="https://instagram.com/lucaspeinado.es">Instagram</a>
        <a href="mailto:hola@lucaspeinado.es"
            >hola[arroba]lucaspeinado[punto]es</a
        >
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const header = document.querySelector("header");

        if (header) {
            document.addEventListener("bgred", (e) => {
                if (e.detail) {
                    header.classList.add("on-red");
                } else {
                    header.classList.remove("on-red");
                }
            });
        }
    });
</script>

<style>
    header {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 8px 16px;
        justify-content: space-between;
        position: fixed !important;
        z-index: 100;
        left: 0;
        right: 0;
        top: 0;
        transition: color 0.5s ease;
    }

    h1 {
        transition: color 0.5s ease;
    }

    .links {
        display: flex;
        flex-direction: row;
        gap: 16px;
        a {
            color: red;
            text-decoration: dotted underline;
            transition: color 0.5s ease;
        }
        a:hover {
            text-decoration: solid underline;
        }
    }

    header.on-red,
    header.on-red h1 {
        color: white;
    }

    header.on-red .links a {
        color: white;
    }
</style>
