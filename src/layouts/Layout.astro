---
interface Props {
    title?: string;
}

const { title = "Lucas Peinado" } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <div id="grid-container"></div>
        <div id="custom-cursor">
            <img src="/cursor.png" alt="" />
        </div>
        <slot />
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "DM Sans";
        src: url("/fonts/DMSans-VariableFont_opsz,wght.ttf") format("truetype");
    }
    @font-face {
        font-family: "DM Sans";
        font-style: italic;
        src: url("/fonts/DMSans-Italic-VariableFont_opsz,wght.ttf")
            format("truetype");
    }

    *,
    *::before,
    *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        min-height: 100vh;
        font-family: "DM Sans", sans-serif;
        background-color: #fff;
    }

    body {
        isolation: isolate;
    }

    @media (hover: hover) and (pointer: fine) {
        html,
        body,
        a,
        button {
            cursor: none;
        }
    }

    #grid-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 10;
        overflow: hidden;
    }

    .grid-dot {
        position: absolute;
        width: 2px;
        height: 2px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        transform-origin: center;
        will-change: transform;
        mix-blend-mode: difference;
    }

    #custom-cursor {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    #custom-cursor.visible {
        opacity: 1;
    }

    #custom-cursor img {
        display: block;
    }
</style>

<script is:inline>
    const GRID_SIZE = 88;
    const DOT_BASE_SIZE = 2;
    const MAX_SCALE = 3.5;
    const NEIGHBOR_SCALE = 1.8;
    const INFLUENCE_RADIUS = 140;
    const NEIGHBOR_RADIUS = GRID_SIZE * 1.5;

    const cursor = document.getElementById("custom-cursor");
    const cursorImg = cursor?.querySelector("img");
    const gridContainer = document.getElementById("grid-container");
    let mouseX = 0;
    let mouseY = 0;
    let cursorX = 0;
    let cursorY = 0;
    let cursorVisible = false;
    let dots = [];
    let cols = 0;
    let rows = 0;

    const CURSOR_OFFSET_X = cursorImg?.width ? cursorImg.width / 2 - 2 : 12;
    const CURSOR_OFFSET_Y = cursorImg?.height ? cursorImg.height / 2 - 2 : 12;
    const SMOOTHING = 0.15;

    let targetRotation = 0;
    let rotation = 0;
    let targetScale = 1;
    let scale = 1;
    const ROTATION_DRIFT = 0.08;
    const CLICK_DRIFT = 0.15;
    const ROTATION_SCALE = 0.0025;

    function createGrid() {
        if (!gridContainer) return;
        cols = Math.ceil(window.innerWidth / GRID_SIZE) + 1;
        rows = Math.ceil(window.innerHeight / GRID_SIZE) + 1;

        const fragment = document.createDocumentFragment();
        dots = [];

        for (let y = 0; y < rows; y++) {
            for (let x = 0; x < cols; x++) {
                const dot = document.createElement("div");
                dot.className = "grid-dot";
                const posX = x * GRID_SIZE;
                const posY = y * GRID_SIZE;
                dot.style.left = `${posX}px`;
                dot.style.top = `${posY}px`;
                dot.dataset.x = posX;
                dot.dataset.y = posY;
                fragment.appendChild(dot);
                dots.push({
                    el: dot,
                    x: posX,
                    y: posY,
                    scale: 1,
                    targetScale: 1,
                });
            }
        }
        gridContainer.appendChild(fragment);
    }

    function updateGrid() {
        const newCols = Math.ceil(window.innerWidth / GRID_SIZE) + 1;
        const newRows = Math.ceil(window.innerHeight / GRID_SIZE) + 1;

        if (newCols !== cols || newRows !== rows) {
            gridContainer.innerHTML = "";
            createGrid();
        }
    }

    function animateDots() {
        for (const dot of dots) {
            const dx = mouseX - dot.x;
            const dy = mouseY - dot.y;
            const dist = Math.hypot(dx, dy);

            if (dist < INFLUENCE_RADIUS) {
                const influence = 1 - dist / INFLUENCE_RADIUS;
                const easedInfluence = influence * influence;
                dot.targetScale = 1 + easedInfluence * (MAX_SCALE - 1);
            } else {
                // Check if neighbor of closest dot
                const gridX = Math.round(mouseX / GRID_SIZE) * GRID_SIZE;
                const gridY = Math.round(mouseY / GRID_SIZE) * GRID_SIZE;
                const neighborDist = Math.hypot(dot.x - gridX, dot.y - gridY);

                if (neighborDist < NEIGHBOR_RADIUS && neighborDist > 0) {
                    const influence = 1 - neighborDist / NEIGHBOR_RADIUS;
                    const easedInfluence = influence * influence;
                    dot.targetScale = 1 + easedInfluence * (NEIGHBOR_SCALE - 1);
                } else {
                    dot.targetScale = 1;
                }
            }

            dot.scale += (dot.targetScale - dot.scale) * 0.15;
            dot.el.style.transform = `scale(${dot.scale})`;
        }
        requestAnimationFrame(animateDots);
    }

    function animateCursor() {
        const prevCursorX = cursorX;
        const prevCursorY = cursorY;
        cursorX += (mouseX - CURSOR_OFFSET_X - cursorX) * SMOOTHING;
        cursorY += (mouseY - CURSOR_OFFSET_Y - cursorY) * SMOOTHING;

        const velocityX = cursorX - prevCursorX;
        const velocityY = cursorY - prevCursorY;
        targetRotation = velocityX * 0.3;

        rotation += (targetRotation - rotation) * ROTATION_DRIFT;

        scale += (targetScale - scale) * CLICK_DRIFT;

        if (cursor) {
            cursor.style.left = `${cursorX}px`;
            cursor.style.top = `${cursorY}px`;
            cursor.style.transformOrigin = `${-CURSOR_OFFSET_X}px ${-CURSOR_OFFSET_Y}px`;
            cursor.style.transform = `rotate(${rotation}deg) scale(${scale})`;
        }

        requestAnimationFrame(animateCursor);
    }

    document.addEventListener("mousemove", (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;

        if (!cursorVisible) {
            cursor?.classList.add("visible");
            cursorVisible = true;
        }
    });

    document.addEventListener("mousedown", () => {
        targetScale = 0.8;
    });

    document.addEventListener("mouseup", () => {
        targetScale = 1;
    });

    window.addEventListener("resize", () => {
        updateGrid();
    });

    if (cursorImg?.complete) {
        init();
    } else if (cursorImg) {
        cursorImg.onload = init;
    } else {
        init();
    }

    function init() {
        createGrid();
        animateDots();
        animateCursor();
    }
</script>
